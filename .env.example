# Existing local Windows/SAP identity (including SSO). Use one exact session ID.
SAP_SESSION_ID=/app/con[0]/ses[0]
# Or omit SAP_SESSION_ID and use the exact SAP Logon connection description:
# SAP_CONNECTION=Your configured SAP connection
# Optional installed saplogon.exe or directory if SAP Logon is not already running:
# SAP_GUI_PATH=C:\Program Files\SAP\FrontEnd\SAPGUI
# Optional identity assertion; must match the authenticated SAP user:
# SAP_USER=YOUR_SAP_USER
# Password login for a NEW connection only (SSO does not need these):
# SAP_CLIENT=100
# SAP_PASSWORD=
SAP_OPERATION_TIMEOUT=30
# Existing directory; screenshot file writes are disabled unless set:
# SAP_OUTPUT_ROOT=C:\SAP-MCP-Screenshots
# Optional preinstalled GuiXT InputScripts; requires AllowExternalInput Yes:
# GUIXT_PATH=C:\Program Files\SAP\FrontEnd\SAPGUI\guixt.exe
# GUIXT_SCRIPT_ROOT=C:\SAP-MCP-GuiXT
